{
  "_comment": "Message text rules (layer 3). Patterns are Python regexes matched against Turkish-normalised text: lower-case, İ/I handled, Turkish letters folded to ASCII (ç→c ğ→g ı→i ö→o ş→s ü→u). Write patterns in that form or with Turkish letters (they are normalised the same way; backslash escapes are kept as written). Each matching pattern adds its weight once; the text score is capped at 40.",
  "max_score": 40,
  "patterns": [
    {"id": "urgency_last_day", "category": "urgency", "weight": 10,
     "pattern": "\\bson\\s+gun(u|unuz|e)?\\b",
     "reason": "Mesaj sizi acele ettirmeye çalışıyor (\"son gün\")."},
    {"id": "urgency_hours", "category": "urgency", "weight": 10,
     "pattern": "\\b\\d{1,2}\\s*saat\\s*(icinde|icerisinde|sonra)\\b",
     "reason": "Mesaj kısa bir süre vererek sizi acele ettiriyor."},
    {"id": "urgency_account_suspended", "category": "urgency", "weight": 15,
     "pattern": "\\b(hesab|kart|hat)\\w*\\s+(\\w+\\s+){0,4}(askiya|bloke|kapat|dondur|kisitla|iptal)\\w*",
     "reason": "Hesabınızın ya da kartınızın kapatılacağı söylenerek korku yaratılıyor."},
    {"id": "urgency_new_device_login", "category": "urgency", "weight": 10,
     "pattern": "\\b(yeni|farkli|bilinmeyen|supheli)\\s+(bir\\s+)?(cihaz|konum|tarayici)\\w*\\s+(\\w+\\s+){0,2}giris",
     "reason": "Hesabınıza yabancı bir giriş yapıldığı söylenerek korku yaratılıyor."},
    {"id": "urgency_now", "category": "urgency", "weight": 5,
     "pattern": "\\b(hemen|acilen|derhal|ivedilikle)\\b",
     "reason": "Mesaj hemen işlem yapmanızı istiyor."},
    {"id": "urgency_final_warning", "category": "urgency", "weight": 10,
     "pattern": "\\bson\\s+(uyari|hatirlatma|ihtar|bildirim)\\b",
     "reason": "Mesaj \"son uyarı\" diyerek baskı kuruyor."},
    {"id": "urgency_destroyed", "category": "urgency", "weight": 10,
     "pattern": "\\b(iade|imha|iptal)\\s+edilecek(tir)?\\b",
     "reason": "Gönderinizin ya da işleminizin iptal edileceği söyleniyor."},

    {"id": "impersonation_edevlet", "category": "impersonation", "weight": 10,
     "pattern": "\\be-?\\s?devlet\\b",
     "reason": "Mesajda e-Devlet adı kullanılıyor. Resmî kurumlar SMS ile link gönderip ödeme istemez."},
    {"id": "impersonation_customs_fee", "category": "impersonation", "weight": 15,
     "pattern": "\\bgumruk\\w*\\s+(ucret|vergi|bedel|harc)\\w*",
     "reason": "Gümrük ücreti istenmesi bilinen bir kargo dolandırıcılığı yöntemidir."},
    {"id": "impersonation_delivery_failed", "category": "impersonation", "weight": 15,
     "pattern": "\\b(adres\\w*\\s+(bilgi\\w*\\s+)?(eksik|hatali|yetersiz|dogrula)\\w*|teslim\\s+edilemedi|dagitima\\s+cikamadi)",
     "reason": "Kargonun teslim edilemediği söyleniyor. Bu, sık kullanılan bir dolandırıcılık bahanesidir."},
    {"id": "impersonation_cargo", "category": "impersonation", "weight": 5,
     "pattern": "\\b(kargo|gonderi|paket)\\w*\\b",
     "reason": "Mesajda kargo ya da gönderi konusu geçiyor."},
    {"id": "impersonation_ptt", "category": "impersonation", "weight": 5,
     "pattern": "\\bptt\\b",
     "reason": "Mesajda PTT adı kullanılıyor."},
    {"id": "impersonation_tax_fine", "category": "impersonation", "weight": 10,
     "pattern": "\\b(vergi|trafik|ceza|icra)\\w*\\s+(borc|odeme|dosya)\\w*",
     "reason": "Borç ya da ceza bildirimi yapılıyor. Bunu kurumun resmî sitesinden kendiniz kontrol edin."},
    {"id": "impersonation_authority", "category": "impersonation", "weight": 10,
     "pattern": "\\b(polis|savci|jandarma|emniyet\\s+mudurlug|masak|interpol)\\w*",
     "reason": "Mesajda polis, savcı veya başka bir resmî görevli adı kullanılıyor."},
    {"id": "impersonation_investigation", "category": "impersonation", "weight": 10,
     "pattern": "\\b(sorusturma|teror\\s+orgut|kara\\s+para|dolandiricilik\\s+dosya)\\w*",
     "reason": "Adınızın bir soruşturmada geçtiği söyleniyor. Gerçek görevliler telefonla para ya da bilgi istemez."},
    {"id": "impersonation_institution", "category": "impersonation", "weight": 5,
     "pattern": "\\b(sgk|gib|gelir\\s+idaresi|hazine|bddk)\\b",
     "reason": "Mesajda bir devlet kurumunun adı kullanılıyor."},

    {"id": "reward_won", "category": "reward", "weight": 15,
     "pattern": "\\bkazan(diniz|din|mis\\s*bulunuyorsunuz)\\b",
     "reason": "Bir şey kazandığınız söyleniyor. Katılmadığınız çekilişi kazanamazsınız."},
    {"id": "reward_refund", "category": "reward", "weight": 15,
     "pattern": "\\biade\\s*(alacag|hakki|tutari|odeme)\\w*|\\balacakli\\s+gorun\\w*",
     "reason": "Size para iadesi yapılacağı söyleniyor. Bu, sık kullanılan bir tuzaktır."},
    {"id": "reward_gift", "category": "reward", "weight": 10,
     "pattern": "\\b(hediye|cekilis|ikramiye|odul|bedava|ucretsiz)\\w*",
     "reason": "Hediye ya da ödül vaat ediliyor."},
    {"id": "reward_bonus_points", "category": "reward", "weight": 10,
     "pattern": "\\b(bonus|puan|chip[- ]?para|maxipuan|worldpuan)\\w*\\s+(yuklen|tanimlan|hediye|kazan)\\w*",
     "reason": "Hesabınıza puan ya da para yükleneceği söyleniyor."},

    {"id": "info_iban", "category": "info_request", "weight": 15,
     "pattern": "\\biban\\w*|\\btr\\s?\\d{2}(\\s?\\d{4}){5}\\s?\\d{2}\\b",
     "reason": "Mesajda IBAN geçiyor. Tanımadığınız kişilere para göndermeyin."},
    {"id": "info_card", "category": "info_request", "weight": 20,
     "pattern": "\\bkart\\s*(bilgi|numara|no|sifre)\\w*|\\bcvv\\b|\\bcvc\\b|\\bson\\s+kullanma\\s+tarih\\w*",
     "reason": "Kart bilgileriniz isteniyor. Bankalar bu bilgileri asla mesajla istemez."},
    {"id": "info_otp", "category": "info_request", "weight": 20,
     "pattern": "\\b(dogrulama|onay|guvenlik|tek\\s+kullanimlik|sms)\\s*(kod|sifre)\\w*|\\botp\\b",
     "reason": "Doğrulama kodu isteniyor. Bu kodu kimseyle paylaşmayın."},
    {"id": "info_password", "category": "info_request", "weight": 15,
     "pattern": "\\b(sifre|parola)\\w*",
     "reason": "Şifreniz isteniyor. Şifrenizi kimseyle paylaşmayın."},
    {"id": "info_identity", "category": "info_request", "weight": 15,
     "pattern": "\\b(t\\.?\\s?c\\.?\\s*(kimlik)?\\s*(no|numara)\\w*|kimlik\\s+(bilgi|numara)\\w*)",
     "reason": "Kimlik bilgileriniz isteniyor."},
    {"id": "info_payment", "category": "info_request", "weight": 10,
     "pattern": "\\b(odeme|ucret|bedel)\\w*\\s+(\\w+\\s+)?(yapin|yapiniz|yapmaniz|gerceklestir|odeyin|odeyiniz)\\w*",
     "reason": "Sizden ödeme yapmanız isteniyor."},
    {"id": "info_safe_account", "category": "info_request", "weight": 15,
     "pattern": "\\bguvenli\\s+(bir\\s+)?hesab\\w*|\\bparanizi\\s+(\\w+\\s+)?(aktar|gonder|cek)\\w*",
     "reason": "Paranızı başka bir hesaba aktarmanız isteniyor. Hiçbir kurum bunu istemez."},
    {"id": "info_verify_details", "category": "info_request", "weight": 10,
     "pattern": "\\b(hemen\\s+)?(dogrula|guncelle)(yin|yiniz|mek\\s+icin|maniz)\\b|\\bbilgi\\w*\\s+(guncelle|dogrula|onayla)\\w*",
     "reason": "Sizden bilgilerinizi doğrulamanız ya da güncellemeniz isteniyor."},
    {"id": "info_click_link", "category": "info_request", "weight": 5,
     "pattern": "\\b(linke|baglantiya|adrese)\\s+(tikla|gir|git)\\w*",
     "reason": "Mesaj sizi bir linke yönlendiriyor."}
  ]
}
