# Copy to .env and fill in. Never commit .env.

# dev | prod  (prod disables /docs)
ENV=dev

# Used for HMAC-SHA256 of device ids and IP addresses. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Postgres
POSTGRES_USER=scamshield
POSTGRES_PASSWORD=scamshield
POSTGRES_DB=scamshield
DATABASE_URL=postgresql+asyncpg://scamshield:scamshield@db:5432/scamshield

# Redis
REDIS_URL=redis://redis:6379/0

# Blacklist feeds (downloaded once a day, at night, by the worker)
USOM_API_URL=https://siberguvenlik.gov.tr/api/address/index
URLHAUS_URL=https://urlhaus.abuse.ch/downloads/text_online/
# URLhaus (abuse.ch) free Auth-Key: https://auth.abuse.ch/  (sent as Auth-Key header when set)
URLHAUS_AUTH_KEY=

# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Comma-separated proxy IPs whose X-Forwarded-For header is trusted (Nginx in prod)
TRUSTED_PROXIES=127.0.0.1
