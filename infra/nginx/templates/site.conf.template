# Rendered by the Nginx image (envsubst) to /etc/nginx/conf.d/site.conf.
# Only ${DOMAIN} and ${HSTS_MAX_AGE} are substituted; plain $nginx_variables are untouched.

# Docker's internal DNS. The API container gets a new address whenever a deploy recreates
# it, so the name is re-resolved (at most every 10 s) instead of only at startup.
resolver 127.0.0.11 valid=10s ipv6=off;
resolver_timeout 5s;

# HTTP: Let's Encrypt challenges, everything else goes to HTTPS.
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN} www.${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://${DOMAIN}$request_uri;
    }
}

# www -> apex.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name www.${DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    include /etc/nginx/conf.d/security-headers.inc;
    return 301 https://${DOMAIN}$request_uri;
}

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    root /usr/share/nginx/html;

    # API: same origin, so the browser needs no CORS. X-Forwarded-For is overwritten
    # (not appended) so clients cannot spoof their address to the API.
    location /api/ {
        limit_req zone=api burst=20 nodelay;
        client_max_body_size 32k;

        set $api_upstream http://api:8000;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;

        # Errors generated by Nginx itself answer in Turkish JSON like the API does.
        # (The API's own error responses pass through unchanged.)
        error_page 413 = @api_too_large;
        error_page 429 = @api_rate_limited;
        error_page 502 503 504 = @api_unavailable;

        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-store" always;
    }

    location @api_too_large {
        default_type application/json;
        include /etc/nginx/conf.d/security-headers.inc;
        return 413 '{"detail":"Gönderilen veri çok büyük."}';
    }

    location @api_rate_limited {
        default_type application/json;
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Retry-After "10" always;
        return 429 '{"detail":"Çok fazla istek gönderdiniz. Lütfen biraz bekleyip tekrar deneyin."}';
    }

    location @api_unavailable {
        default_type application/json;
        include /etc/nginx/conf.d/security-headers.inc;
        return 503 '{"detail":"Hizmet şu anda kullanılamıyor. Lütfen daha sonra tekrar deneyin."}';
    }

    # API docs are disabled in prod anyway; Expo's route list is not for the public.
    location ~ ^/(docs|redoc|openapi\.json|_sitemap) {
        return 404;
    }

    # Content-hashed build output: cache for a year.
    location ~ ^/(_expo/static|assets)/ {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Statically rendered pages (/, /hakkinda, /gizlilik, /kvkk).
    location / {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri.html $uri/index.html =404;
    }

    error_page 404 /+not-found.html;
    location = /+not-found.html {
        internal;
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-cache" always;
    }
}
