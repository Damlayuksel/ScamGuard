# Production settings. Copy to infra/.env.prod on the server and fill in.
# infra/.env.prod is never committed.

# Public domain (temporary: lovelockapp.com). www.<DOMAIN> redirects to it.
DOMAIN=lovelockapp.com
# Let's Encrypt account e-mail (expiry warnings).
LETSENCRYPT_EMAIL=
# HSTS max-age in seconds. Start small (300); after HTTPS has worked for a week raise it
# to 31536000 (1 year). includeSubDomains/preload are deliberately not used.
HSTS_MAX_AGE=300

# HMAC key for device ids and IP addresses. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

POSTGRES_USER=scamshield
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=
POSTGRES_DB=scamshield

# URLhaus (abuse.ch) Auth-Key, optional.
URLHAUS_AUTH_KEY=

# Internal Docker network. NGINX_IP must be inside INTERNAL_SUBNET; the API trusts
# X-Forwarded-For only from this address.
INTERNAL_SUBNET=172.28.0.0/24
NGINX_IP=172.28.0.10
